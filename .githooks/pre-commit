#!/bin/sh
# Pre-commit hook pro projekt Půjčovna vybavení (PPRO)
# Účel: Kontrola a připomínka aktualizace technické dokumentace (README.md) před commitem

echo "========================================================"
echo "🔍 [pre-commit hook] Kontrola technické dokumentace..."
echo "========================================================"

# Zjištění fázovaných souborů (staged files)
STAGED_FILES=$(git diff --cached --name-only)

if echo "$STAGED_FILES" | grep -q "^README.md$"; then
    echo "✅ README.md (technická dokumentace) je součástí tohoto commitu."
else
    echo "ℹ️  UPOZORNĚNÍ: README.md není v tomto commitu upravena."
    echo "    Před commitem ověřte, zda provedené změny nevyžadují"
    echo "    záznam rozhodnutí nebo aktualizaci dokumentace v README.md."
fi

echo "========================================================"
exit 0
